# ============================================================
# SinMail — configuración
# Copia este archivo a `.env` y rellena los valores.
# ============================================================

# --- Google OAuth (Google Cloud Console → APIs y servicios → Credenciales) ---
# ID de cliente de OAuth (termina en .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# Secreto de cliente de OAuth
GOOGLE_CLIENT_SECRET=
# URI de redirección — debe coincidir EXACTAMENTE con la registrada en Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# --- Proveedor de IA ---
# Proveedor activo: "groq" (por defecto, capa gratuita) o "anthropic"
AI_PROVIDER=groq

# API key de Groq (console.groq.com → API Keys)
GROQ_API_KEY=
# Modelo de Groq (llama-3.1-8b-instant: rápido, gratis, 30 req/min)
GROQ_MODEL=llama-3.1-8b-instant

# API key de Anthropic (solo si AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Modelo de Anthropic
ANTHROPIC_MODEL=claude-opus-4-8

# --- Servidor ---
PORT=3000

# Clave secreta para sesiones y cifrado de tokens de Google (AES-256-GCM).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
